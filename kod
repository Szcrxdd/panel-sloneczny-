#include <Servo.h>

Servo serwo;

int pozycja = 90;   // start na środku

void setup() {
  serwo.attach(9);
  serwo.write(pozycja);
  Serial.begin(9600);
}

void loop() {
  int lewy = 0;
  int prawy = 0;

 for(int i = 0; i < 5; i++) {
  lewy += analogRead(A0);
  prawy += analogRead(A1);
  delay(5);
}

lewy /= 5;
prawy /= 5;

  int roznica = lewy - prawy;

  Serial.print("L: ");
  Serial.print(lewy);
  Serial.print(" P: ");
  Serial.print(prawy);
  Serial.print(" R: ");
  Serial.println(roznica);

  int prog = 100; // czułość

  if (roznica > prog) {
    pozycja+=1;
  }
  else if (roznica < -prog) {
    pozycja-=1;
  }

  // ograniczenie zakresu serwa
  pozycja = constrain(pozycja, 0, 180);

  serwo.write(pozycja);

  delay(50);
}
